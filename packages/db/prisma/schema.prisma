// Schéma Prisma de Linkaro.
// Les modèles sont ajoutés fonctionnalité par fonctionnalité (audit, auth, créateurs…).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Traçabilité ──────────────────────────────────────────────────────────────
// Voir docs/architecture/02-securite-et-conformite.md.

enum ActorType {
  USER // créateur ou marque connecté
  ADMIN // membre de l'équipe Linkaro
  SYSTEM // tâche automatique (worker, purge…)
  ANONYMOUS // visiteur non connecté (tentative de connexion…)
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED // refusé par une règle d'autorisation
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

/// Journal d'audit : qui a fait quoi, quand, d'où, et ce qui a changé.
/// En ajout seul : l'application ne peut ni modifier ni supprimer une ligne
/// (droits SQL + déclencheur), et chaque ligne contient l'empreinte de la
/// précédente (chaînage), ce qui rend toute altération détectable.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  createdAt  DateTime    @map("created_at") @db.Timestamptz(3)
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id")
  actorRole  String?     @map("actor_role")
  /// Action au format domaine.verbe, par exemple « auth.login » ou « social.connect ».
  action     String
  targetType String?     @map("target_type")
  targetId   String?     @map("target_id")
  result     AuditResult
  /// Motif saisi pour une action d'administration, ou cause d'un échec.
  reason     String?
  /// Valeurs avant / après, déjà expurgées des données secrètes.
  changes    Json?
  metadata   Json?
  requestId  String?     @map("request_id")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  prevHash   String      @map("prev_hash")
  hash       String      @unique

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
  @@index([ipAddress, createdAt])
  @@map("audit_log")
}

/// Événements de sécurité : connexions, échecs, blocages, accès refusés.
model SecurityEvent {
  id         BigInt           @id @default(autoincrement())
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Type au format domaine.événement, par exemple « auth.login_failed ».
  type       String
  severity   SecuritySeverity
  userId     String?          @map("user_id")
  /// Identifiant de connexion tenté, toujours masqué (ex. +237 6•• •• •• 12).
  identifier String?
  ipAddress  String?          @map("ip_address")
  userAgent  String?          @map("user_agent")
  requestId  String?          @map("request_id")
  details    Json?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([requestId])
  @@map("security_event")
}

// ─── Créateurs : comptes et authentification ──────────────────────────────────
// Tables gérées par Better Auth (packages/auth). Pas de mot de passe : un créateur
// s'inscrit en connectant un réseau social. Voir docs/architecture/03-acces-et-collecte-des-donnees.md.

model Creator {
  id               String           @id
  name             String
  /// E-mail du réseau, ou adresse factice non routable (…@comptes.linkaro.invalid)
  /// pour les réseaux qui n'en fournissent pas.
  email            String           @unique
  emailVerified    Boolean          @default(false) @map("email_verified")
  image            String?
  /// active | suspended
  status           String           @default("active")
  /// Confirmation « J'ai 18 ans ou plus » (obligation légale).
  adultConfirmedAt DateTime?        @map("adult_confirmed_at") @db.Timestamptz(3)
  termsAcceptedAt  DateTime?        @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion     String?          @map("terms_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         CreatorSession[]
  accounts         CreatorAccount[]

  @@map("creator")
}

model CreatorSession {
  id        String   @id
  /// Jeton de session (cookie httpOnly).
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("creator_id")
  creator   Creator  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("creator_session")
}

/// Réseau social connecté. Les tokens sont chiffrés par Better Auth (encryptOAuthTokens).
model CreatorAccount {
  id                    String    @id
  /// Identifiant du compte chez le réseau (open_id TikTok, sub Google…).
  accountId             String    @map("account_id")
  /// google | facebook | tiktok | linkaro-dev…
  providerId            String    @map("provider_id")
  userId                String    @map("creator_id")
  creator               Creator   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Imposé par Better Auth ; jamais utilisé (aucun mot de passe chez Linkaro).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("creator_account")
}

/// Valeurs temporaires de Better Auth (state OAuth…).
model CreatorVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("creator_verification")
}

/// Compteurs de limitation de débit (anti-force brute, anti-abus).
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limit")
}

// ─── Équipe Linkaro : comptes, invitations, double authentification ───────────
// Annuaire séparé des créateurs (packages/auth/src/staff-auth.ts). Aucun mot de passe,
// aucune inscription : premier superadmin créé par script, les autres sont invités.

model StaffMember {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?
  /// superadmin | ops | support | tech (contrainte CHECK en base)
  role             String
  /// active | disabled (contrainte CHECK en base)
  status           String            @default("active")
  twoFactorEnabled Boolean?          @default(false) @map("two_factor_enabled")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         StaffSession[]
  accounts         StaffAccount[]
  twoFactors       StaffTwoFactor[]
  invitationsSent  StaffInvitation[] @relation("InvitedBy")

  @@map("staff_member")
}

model StaffSession {
  id                     String      @id
  token                  String      @unique
  expiresAt              DateTime    @map("expires_at") @db.Timestamptz(3)
  ipAddress              String?     @map("ip_address")
  userAgent              String?     @map("user_agent")
  /// Renseigné uniquement après un code de double authentification valide.
  secondFactorVerifiedAt DateTime?   @map("second_factor_verified_at") @db.Timestamptz(3)
  userId                 String      @map("staff_member_id")
  member                 StaffMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("staff_session")
}

/// Imposé par Better Auth (le lien magique n'en crée pas de nouveau).
model StaffAccount {
  id                    String      @id
  accountId             String      @map("account_id")
  providerId            String      @map("provider_id")
  userId                String      @map("staff_member_id")
  member                StaffMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?     @map("access_token")
  refreshToken          String?     @map("refresh_token")
  idToken               String?     @map("id_token")
  accessTokenExpiresAt  DateTime?   @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("staff_account")
}

/// Valeurs temporaires (liens magiques, défis de double authentification…).
model StaffVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("staff_verification")
}

/// Secret TOTP et codes de secours (chiffrés par Better Auth).
model StaffTwoFactor {
  id                      String      @id
  secret                  String
  backupCodes             String      @map("backup_codes")
  verified                Boolean?    @default(true)
  failedVerificationCount Int?        @default(0) @map("failed_verification_count")
  lockedUntil             DateTime?   @map("locked_until") @db.Timestamptz(3)
  userId                  String      @map("staff_member_id")
  member                  StaffMember @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("staff_two_factor")
}

/// Invitation d'un membre de l'équipe. Seule l'empreinte du jeton est stockée.
model StaffInvitation {
  id          String       @id @default(uuid())
  email       String
  /// superadmin | ops | support | tech (contrainte CHECK en base)
  role        String
  /// SHA-256 du jeton envoyé (le jeton lui-même n'est jamais stocké).
  tokenHash   String       @unique @map("token_hash")
  /// Motif de l'invitation (obligatoire, inscrit à l'audit).
  reason      String
  /// Absent pour le premier superadmin (créé par script sur le serveur).
  invitedById String?      @map("invited_by_id")
  invitedBy   StaffMember? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?    @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email])
  @@map("staff_invitation")
}
