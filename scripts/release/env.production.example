# Variables d'environnement de production (exemple).
# Sur cPanel : à saisir dans « Setup Node.js App » → Environment variables
# (ou à copier en .env dans standalone/apps/<app>/). Ne jamais commiter de valeurs réelles.

NODE_ENV=production

# PostgreSQL
# Sur un hébergement mutualisé il n'y a souvent qu'un seul utilisateur : mettre la même URL dans les deux.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_BASE?schema=public
DATABASE_MIGRATION_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_BASE?schema=public

# Adresses publiques (HTTPS obligatoire en production)
WEB_URL=https://app.exemple.com
ADMIN_URL=https://admin.exemple.com

LOG_LEVEL=info

# Derrière le proxy de l'hébergeur (Apache / nginx / Passenger) : 1. Accès direct : 0.
TRUSTED_PROXY_HOPS=1

# Secrets (32 caractères minimum, différents l'un de l'autre). Générer avec : openssl rand -base64 48
# CREATOR_AUTH_SECRET sert aussi à chiffrer les jetons des réseaux : ne plus la changer ensuite.
CREATOR_AUTH_SECRET=
STAFF_AUTH_SECRET=

# Réseaux sociaux (laisser vide pour désactiver un fournisseur)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Interdit en production (le serveur refuse de démarrer s'il vaut true)
ENABLE_DEV_OAUTH=false

# E-mails : serveur SMTP obligatoire en production (celui de la boîte créée dans cPanel, par exemple)
SMTP_HOST=mail.exemple.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@exemple.com
SMTP_PASSWORD=
MAIL_FROM=Linkaro <no-reply@exemple.com>
