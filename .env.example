# Copier ce fichier en .env (à la racine du monorepo) et adapter les valeurs.
# Ne jamais commiter le fichier .env.

NODE_ENV=development

# PostgreSQL — deux rôles (voir packages/db/scripts/setup-roles.sql)
# Rôle applicatif (web, admin, worker) : lecture/écriture des données, pas de modification du schéma.
DATABASE_URL=postgresql://linkaro_app:linkaro_app_dev@localhost:5432/linkaro_dev?schema=public
# Rôle propriétaire, utilisé uniquement par les migrations Prisma.
DATABASE_MIGRATION_URL=postgresql://linkaro_migrator:linkaro_migrator_dev@localhost:5432/linkaro_dev?schema=public

# URLs publiques des applications
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Journaux : trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Nombre de proxys de confiance devant l'app (Caddy en production = 1, accès direct = 0).
# Sert à déterminer l'IP réelle du client à partir de X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
