{
  "name": "worker",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@linkaro/db": "workspace:*",
    "@linkaro/env": "workspace:*"
  },
  "devDependencies": {
    "@linkaro/eslint-config": "workspace:*",
    "@linkaro/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
